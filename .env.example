# Основной провайдер LLM (gigachat или groq)
LLM_PROVIDER=gigachat

# Ключ авторизации Сбер GigaChat API (получить на developers.sber.ru)
GIGACHAT_CREDENTIALS=

# Ключ Groq API (получить на console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Подключение к PostgreSQL (опционально, при отсутствии работают встроенные датасеты data/)
DATABASE_URL=
